# =============================================================================
# HAPI ID V2-E Stage 1 — staging service environment template
# Issuer: https://id-staging.hapiinc.com  (Railway staging service ONLY)
# =============================================================================
# This file documents the exact variable names and non-secret values for the
# isolated staging service. It is a template: no secret value appears here and
# nothing reads this file in production. The production service's environment
# (identity.bookwrm.com) is NOT changed by anything in this file.
#
# Hard rules (Stage 0 design §10, enforced where possible at boot):
#   - No production credential of any kind is ever set in the staging service.
#   - Staging PostgreSQL and Redis are dedicated instances, never shared.
#   - Signing keys are freshly generated for staging and used nowhere else.
# =============================================================================

# --- Issuer pin (boot fails closed unless all three are set exactly) --------
OIDC_ISSUER=https://id-staging.hapiinc.com
# Stage 1 boot enforcement: must contain ONLY the staging issuer (single entry).
OIDC_ALLOWED_ISSUERS=https://id-staging.hapiinc.com
# Stage 1 boot enforcement: required for any non-default issuer. Staging browser
# origins only — production/Bookwrm origins are deliberately absent.
CORS_TRUSTED_ORIGINS=https://id-staging.hapiinc.com,https://staging-app.hapiinc.com

# --- Dedicated staging stores ------------------------------------------------
# Railway staging PostgreSQL 16 plugin connection string (synthetic identities only;
# never a database/schema inside the production cluster).
DATABASE_URL=
# Railway staging Redis connection string (dedicated instance).
REDIS_URL=
# Defense-in-depth namespace separation even on the dedicated instance.
OIDC_REDIS_NAMESPACE=oidc-staging

# --- Signing keys (staging-only material; generate fresh, never copy prod) ---
# RSA private key PEM generated for staging only (or provide OIDC_JWKS_JSON).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional explicit JWKS ring (staging keys only).
# OIDC_JWKS_JSON=
OIDC_KEY_ROTATION_INTERVAL_SECONDS=3600

# --- V2 feature flags: ALL OFF for Stage 1 certification ---------------------
HAPI_APPLE_FEDERATION_ENABLED=false
HAPI_GOOGLE_FEDERATION_ENABLED=false
HAPI_ACCOUNT_LINKING_API_ENABLED=false
HAPI_PERSISTENT_SESSIONS_ENABLED=false
HAPI_REFRESH_GRANT_ENABLED=false
# Pre-V2 flags also stay off during staging certification.
HAPI_EMAIL_AUTHENTICATION_ENABLED=false
HAPI_FACE_ENROLLMENT_ENABLED=false
HAPI_FACE_SETUP_ENABLED=false
HAPI_UNIVERSAL_LOGIN_ENABLED=false

# --- PrivateID: INACTIVE for the staging pilot -------------------------------
# Production-mode boot requires these URLs even while PrivateID is inactive.
PRIVATEID_CALLBACK_URL=https://id-staging.hapiinc.com/privateid/webhook
PRIVATEID_REDIRECT_URL=https://id-staging.hapiinc.com/privateid/callback
# Leave the credentials unset. If PrivateID is ever exercised in staging
# (separate approval), use the PrivateID TEST tenant/API key only:
# PRIVATEID_AUTH_BASE_URL=
# PRIVATEID_AUTH_API_KEY=
# PRIVATEID_WEBHOOK_SHARED_SECRET=
PRIVATEID_MOCK_MODE=true

# --- Identity API upstream: staging stub / synthetic only --------------------
# Must NEVER hold the production Base44/identity-API endpoint or key.
BASE44_BASE_URL=
IDENTITY_API_PATH=
BOOKWRM_IDENTITY_API_KEY=
HAPI_PLATFORM_SERVICE_KEY=

# --- Email (only needed if OTP flows are exercised; staging Resend key only) --
# RESEND_API_KEY=
# HAPI_EMAIL_FROM=
# HAPI_EMAIL_VERIFICATION_SECRET=

# --- Staging OAuth clients ----------------------------------------------------
# Synthetic clients are seeded in the staging PostgreSQL (staging-web,
# staging-native). The production Bookwrm/Base44 client is NOT registered here:
# leave every OIDC_BASE44_* variable unset in staging.

# --- Runtime ------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
METRICS_ENABLED=true
REDIS_ENABLED=true
CACHE_ENABLED=true
OIDC_ENABLED=true
# No mock/test identity shortcuts during certification of real flows.
MOCK_AUTH_ENABLED=false
# OIDC_TEST_USER_* must remain unset in staging.
