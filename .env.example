BASE44_BASE_URL=
IDENTITY_API_PATH=
BOOKWRM_IDENTITY_API_KEY=
HAPI_PLATFORM_SERVICE_KEY=

# H4 is disabled unless explicitly enabled; requires the existing H2 Resend/PostgreSQL configuration.
HAPI_EMAIL_AUTHENTICATION_ENABLED=false

# H5 is disabled by default; enable only after approval. Requires H4 and PostgreSQL.
HAPI_FACE_ENROLLMENT_ENABLED=false

# H6 Universal Login: when true, interactive GET /authorize shows the HAPI-hosted method chooser
# (Email via H4, Face via PrivateID). When false, GET /authorize launches PrivateID Face directly.
HAPI_UNIVERSAL_LOGIN_ENABLED=false
